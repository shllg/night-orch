{
  "name": "night-orch",
  "version": "0.21.0",
  "description": "Nightly GitHub/Forgejo issue orchestrator — autonomous AI agent coding tool",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shllg/night-orch"
  },
  "type": "module",
  "bin": {
    "night-orch": "./dist/cli/index.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "monitoring/",
    "examples/",
    "docker-compose.example.yaml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run web:build && tsc -p tsconfig.json",
    "build": "pnpm web:build && tsc -p tsconfig.json",
    "install-global": "pnpm web:build && tsc -p tsconfig.json && pnpm link --global",
    "dev": "tsx src/cli/index.ts",
    "dev:web-only": "pnpm web:build && night-orch demo --port 3250",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:typecheck": "tsc -p .storybook/tsconfig.json --noEmit",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint src/ test/ web/src/",
    "audit": "pnpm audit --audit-level moderate",
    "typecheck": "tsc --noEmit && pnpm web:typecheck && pnpm storybook:typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/index.ts doctor"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.5.12",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@octokit/plugin-retry": "^8.1.0",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "acpx": "^0.4.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "content-type": "^1.0.5",
    "execa": "^9.6.1",
    "ink": "^6.8.0",
    "nanoid": "^5.1.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "raw-body": "^3.0.2",
    "react": "^19.2.4",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "yaml": "^2.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "^10.3.4",
    "@storybook/react-vite": "^10.3.4",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-router": "^1.168.10",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "daisyui": "^5.5.19",
    "eslint": "^9.20.0",
    "jsdom": "^29.0.1",
    "node-gyp": "^12.2.0",
    "react-dom": "^19.2.4",
    "storybook": "^10.3.4",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.2",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@hono/node-server": "^1.19.13",
    "hono": "^4.12.18",
    "yaml": "^2.8.3",
    "path-to-regexp": "^8.4.0",
    "picomatch": "^4.0.4"
  },
  "pnpm": {
    "overrides": {
      "@hono/node-server": "^1.19.13",
      "hono": "^4.12.18",
      "yaml": "^2.8.3",
      "path-to-regexp": "^8.4.0",
      "picomatch": "^4.0.4",
      "ws@<8.20.1": "^8.20.1",
      "fast-uri@<3.1.2": "^3.1.2",
      "qs@<6.15.2": "^6.15.2",
      "postcss@<8.5.10": "^8.5.10",
      "ip-address@<=10.1.0": "^10.1.1",
      "minimatch@3>brace-expansion": "^1.1.13",
      "minimatch@10>brace-expansion": "^5.0.6",
      "vitepress>vite": "^7.3.2",
      "esbuild": "^0.25.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
