{
  "name": "night-orch",
  "version": "0.1.0",
  "description": "Nightly GitHub/Forgejo issue orchestrator — autonomous AI agent coding tool",
  "type": "module",
  "bin": {
    "night-orch": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "install-global": "tsc -p tsconfig.json && pnpm link --global",
    "dev": "tsx src/cli/index.ts",
    "lint": "eslint src/ test/",
    "audit": "pnpm audit --audit-level moderate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "doctor": "tsx src/cli/index.ts doctor"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@octokit/rest": "^22.0.1",
    "acpx": "^0.4.0",
    "better-sqlite3": "^12.8.0",
    "commander": "^14.0.3",
    "content-type": "^1.0.5",
    "execa": "^9.6.1",
    "ink": "^6.8.0",
    "nanoid": "^5.1.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "prom-client": "^15.1.3",
    "raw-body": "^3.0.2",
    "react": "^19.2.4",
    "yaml": "^2.8.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "yaml": "^2.8.3",
      "path-to-regexp": "^8.4.0",
      "picomatch": "^4.0.4",
      "minimatch@3>brace-expansion": "^1.1.13",
      "minimatch@10>brace-expansion": "^5.0.5"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
