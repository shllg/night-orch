# GitHub personal access token (classic or fine-grained)
#
# Option A: Copy from existing gh CLI auth
#   gh auth token
#
# Option B: Create a new fine-grained token at
#   https://github.com/settings/personal-access-tokens/new
#
#   Required permissions (on target repos):
#     - Issues: Read & Write (list issues, post comments, manage labels)
#     - Pull requests: Read & Write (create/update PRs)
#     - Contents: Read & Write (push branches)
#
# Option C: Create a classic token at
#   https://github.com/settings/tokens/new
#
#   Required scopes: repo
#
GITHUB_TOKEN=

# Grafana local admin password (monitoring stack)
# Required by docker-compose.yaml
GRAFANA_ADMIN_PASSWORD=
