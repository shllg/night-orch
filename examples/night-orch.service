[Unit]
Description=night-orch — Nightly GitHub issue orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
WorkingDirectory=%h/apps/night-orch
Environment=HOME=%h
Environment=XDG_CONFIG_HOME=%h/.config
Environment=XDG_DATA_HOME=%h/.local/share
Environment=XDG_CACHE_HOME=%h/.cache
Environment=XDG_STATE_HOME=%h/.local/state
Environment=MISE_CONFIG_DIR=%h/.config/mise
Environment=MISE_DATA_DIR=%h/.local/share/mise
Environment=MISE_CACHE_DIR=%h/.cache/mise
Environment=MISE_STATE_DIR=%h/.local/state/mise
Environment=PNPM_HOME=%h/.local/share/pnpm
Environment=PATH=%h/.local/bin:%h/.local/share/pnpm:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/apps/night-orch/.env
ExecStart=%h/.local/share/pnpm/night-orch serve --config %h/.night-orch/config.yaml
Restart=on-failure
RestartSec=30

# Prevent sleep during active runs
ExecStartPre=/usr/bin/systemd-inhibit --what=sleep --who=night-orch --why="Processing issues" --mode=delay sleep 0

# Resource limits
MemoryMax=2G
CPUQuota=200%

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config %h/.cache %h/.local %h/.night-orch %h/apps

[Install]
WantedBy=default.target
